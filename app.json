{
  "expo": {
    "name": "MoniVue",
    "slug": "monivue",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-monivue.png",
    "scheme": "monivue",
    "userInterfaceStyle": "automatic",

    "ios": {
      "icon": "./assets/icon-monivue.icon",
      "bundleIdentifier": "com.mterrefortes.monivue"
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mterrefortes.monivue"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f2f2f2",

          "image": "./assets/images/icon-monivue.png",

          "imageWidth": 120,

          "resizeMode": "contain"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
